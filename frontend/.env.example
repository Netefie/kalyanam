# Base URL of the Kalyanam backend API (no trailing slash, no /api suffix).
# Copy this file to `.env.local` and adjust as needed.
#
# NOTE: macOS uses port 5000 for AirPlay Receiver. If the backend can't bind
# to 5000 locally, run it on another port (e.g. 5055) and match it here.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Server-only base URL for the same backend, used by the settings fetch in
# lib/settings.ts. Optional — falls back to NEXT_PUBLIC_API_URL. Set it when
# server-side rendering should reach the API over an internal hostname rather
# than egressing through the public domain.
# API_URL=http://localhost:5000

# Canonical public origin, no trailing slash. Every canonical URL, og:url,
# sitemap entry and JSON-LD @id is built from this, so on a real deployment it
# must be the domain visitors actually reach — pointing it at a preview URL
# tells Google the production pages are duplicates of a host it can't crawl.
# Defaults to https://www.kalyanamhotel.com (see WEBSITE in lib/site.ts).
NEXT_PUBLIC_SITE_URL=https://www.kalyanamhotel.com
