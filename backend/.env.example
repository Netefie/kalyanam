# ---- Server ----
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins (no trailing slash).
# Next uses :3001 when :3000 is taken, so both are allowed by default.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ---- Database ----
# Local dev:   mongodb://127.0.0.1:27017/kalyanam
# Atlas (free M0): mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/kalyanam?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/kalyanam

# ---- Auth ----
# Generate a strong secret, e.g. `openssl rand -base64 32`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Email (SMTP) ----
# Leave SMTP_HOST/USER/PASS blank to disable email — bookings, enquiries and
# subscribers still work, sending is just skipped (and logged as `skipped`
# in the admin Emails console).
# Gmail: host=smtp.gmail.com, port=465, secure=true, user=<address>,
# pass=<16-char app password from https://myaccount.google.com/apppasswords>
# (not the account password — Gmail rejects plain-password SMTP logins).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Must match SMTP_USER for an unverified sender — see config/env.js.
MAIL_FROM=Kalyanam Hotel & Resort <no-reply@kalyanam.com>
# Where guest replies land. Defaults to SMTP_USER when blank.
MAIL_REPLY_TO=
# Recipient for internal alerts (new booking, new enquiry, payment failed,
# refund). Defaults to SMTP_USER when blank.
MAIL_ADMIN_TO=
# Recipient used by `npm run test:mail -- --live` and the admin console's
# "send test" box, so verification never reaches guests or staff.
MAIL_TEST_TO=
# Explicit kill switch, independent of whether credentials are set.
MAIL_ENABLED=true
# Renders and logs every email without opening an SMTP connection — safe
# for CI.
MAIL_DRY_RUN=false
MAIL_MAX_RETRIES=3

# Public URL of the frontend — email CTA buttons (view booking, browse
# rooms, open the admin record) link here. Defaults to the first
# CORS_ORIGIN when blank.
SITE_URL=http://localhost:3000

# ---- Seed admin (used only by `npm run seed`) ----
SEED_ADMIN_NAME=Kalyanam Admin
SEED_ADMIN_EMAIL=admin@kalyanam.com
SEED_ADMIN_PASSWORD=Kalyanam@346

# ---- Payments (Razorpay) ----
# Get test keys from https://dashboard.razorpay.com/app/keys (Test Mode).
# Required in production — the app fails fast at boot if missing there.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set after creating the webhook in the Razorpay dashboard (see README's
# "Payments" section) — required in production to accept webhook events.
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_CURRENCY=INR
# Minutes a website booking holds its room inventory while awaiting payment.
BOOKING_HOLD_MINUTES=15

# ---- Booking policy ----
# IANA zone every stay date is anchored to — this defines what "the same
# night" means across every client (browser, admin, scripts). Two bookings
# for the same calendar night must resolve to the same stored instant
# regardless of which timezone sent the request.
HOTEL_TIMEZONE=Asia/Kolkata
# Longest stay a single booking can request, in nights.
BOOKING_MAX_NIGHTS=30
# Most rooms a single booking can request.
BOOKING_MAX_ROOMS=5
# How far in advance a booking can be made, in days.
BOOKING_MAX_ADVANCE_DAYS=365
